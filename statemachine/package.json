{
  "name": "langium-statemachine-dsl",
  "displayName": "State Machine DSL",
  "version": "4.4.0",
  "description": "Official Langium state machine example, extended with langium-tools.",
  "homepage": "https://langium.org",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26",
    "npm": ">=10.2.3",
    "vscode": "^1.123.0"
  },
  "license": "MIT",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "statemachine",
        "aliases": [
          "Statemachine",
          "statemachine"
        ],
        "extensions": [
          ".statemachine"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "statemachine",
        "scopeName": "source.statemachine",
        "path": "./syntaxes/statemachine.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:statemachine"
  ],
  "files": [
    "bin",
    "out",
    "src",
    "syntaxes",
    "language-configuration.json"
  ],
  "bin": {
    "statemachine-cli": "./bin/cli.js"
  },
  "type": "module",
  "main": "./out/extension.cjs",
  "scripts": {
    "build": "tsc -b tsconfig.src.json && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "langium:generate": "langium generate",
    "test": "npm run build && GENERATOR_TEST=verify vitest run",
    "test:generate": "GENERATOR_TEST=generate vitest run test/generator"
  },
  "dependencies": {
    "chalk": "~6.0.1",
    "commander": "~15.1.0",
    "langium": "^4.4.2",
    "langium-tools": "file:../../langium-tools",
    "vscode-languageclient": "~10.1.0",
    "vscode-languageserver": "~10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.125.0",
    "esbuild": "0.28.2",
    "langium-cli": "^4.4.1",
    "typescript": "~5.8.3",
    "vitest": "~2.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisbrodski/langium-tools-showcases.git",
    "directory": "statemachine"
  },
  "bugs": "https://github.com/borisbrodski/langium-tools-showcases/issues",
  "author": {
    "name": "TypeFox",
    "url": "https://www.typefox.io"
  }
}
